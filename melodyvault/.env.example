# MelodyVault Environment Configuration Template
# Duplicate this file as .env and provide your secret credentials.
# Do NOT commit .env to GitHub.

# -------------------------------------------------------------
# Creator Authentication (Fail-closed: authentication disabled if unset)
# -------------------------------------------------------------
CREATOR_PASSWORD="<choose-a-strong-secret-passkey-for-navneeth-creator>"

# -------------------------------------------------------------
# Backend Production Database (PostgreSQL / Supabase)
# Required when running with SPRING_PROFILES_ACTIVE=prod
# -------------------------------------------------------------
DATASOURCE_URL="jdbc:postgresql://<host>:5432/<database>?sslmode=require"
DATASOURCE_USERNAME="postgres"
DATASOURCE_PASSWORD="<production-database-password>"

# -------------------------------------------------------------
# CORS & Cookie Security
# -------------------------------------------------------------
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"
COOKIE_SECURE="false"

# -------------------------------------------------------------
# Music Library Directory (Defaults to repository portable public/demo-music)
# Override with custom personal folder (e.g. C:\MelodyVault Sample Music) if desired
# -------------------------------------------------------------
MUSIC_LIBRARY_DIR="public/demo-music"

# -------------------------------------------------------------
# AI Services & Gemini API
# -------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
